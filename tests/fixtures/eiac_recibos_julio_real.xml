<!-- 5 casos reales cruzados a mano por Sebastián (conversación), extraídos
     y re-verificados directamente contra los 8 ficheros EIAC reales que
     ya tiene descargados. Estructura real (DatosPoliza/IdPoliza,
     DatosRecibo/Fechas/..., DatosRecibo/GestionCobro/DatosFormaPago/...,
     DatosRecibo/DatosImportes/Importes/...)  -  sin bloques de datos
     personales (Persona/Titular/Domicilio/Contacto/IBAN), que el parser
     no lee y que en el fichero real sí contienen PII de clientes.

     Dos de las 5 pólizas (64201679, 64226440) incluyen aquí un intento
     PE previo con un importe ligeramente distinto al CO final  -  el
     mismo patrón de "reintentos con céntimos que fluctúan" que se
     encontró en los ficheros reales y que motivó cambiar la clave de
     deduplicación de (id_poliza, importe) a (id_poliza, fecha_efecto).

     Cálculo manual verificado: 1076.40 + 1512.00 + 1778.40 + 590.40 +
     1409.40 = 6366.60€ -->
<ProcesosEIAC xmlns="http://www.tirea.es/EIAC/ProcesosEIAC">
  <Objetos>
    <!-- Poliza 1 (24300-64174100): 89.70 * 12 = 1.076,40 -->
    <Recibo>
      <DatosPoliza>
        <IdPoliza>24300-64174100</IdPoliza>
      </DatosPoliza>
      <DatosRecibo>
        <SituacionRecibo>CO</SituacionRecibo>
        <Fechas>
          <FechaEfectoInicial>2026-06-30T00:00:00</FechaEfectoInicial>
        </Fechas>
        <GestionCobro>
          <DatosFormaPago>
            <ClaseFormaPago>CC</ClaseFormaPago>
          </DatosFormaPago>
        </GestionCobro>
        <DatosImportes>
          <Importes>
            <PrimaTotal>89.85</PrimaTotal>
            <PrimaNeta>89.70</PrimaNeta>
          </Importes>
        </DatosImportes>
      </DatosRecibo>
    </Recibo>

